{
  "name": "heicraft",
  "version": "0.1.1",
  "description": "Modern HEIC/HEIF conversion toolkit for JavaScript and TypeScript.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/ragnarok22/heicraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragnarok22/heicraft.git"
  },
  "bugs": {
    "url": "https://github.com/ragnarok22/heicraft/issues"
  },
  "keywords": [
    "heic",
    "heif",
    "jpeg",
    "jpg",
    "png",
    "webp",
    "convert",
    "image",
    "browser",
    "node",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "browser": {
    "node:fs/promises": "./dist/browser/fs-promises.js",
    "sharp": "./dist/browser/sharp.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm run build",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:dist": "node -e \"import('./dist/index.js').then((mod) => { const exports = ['convertHeic', 'isHeic', 'detectHeic', 'getHeicInfo', 'HeicraftError', 'InvalidInputError', 'UnsupportedFormatError', 'ConversionError', 'AbortError']; for (const name of exports) { if (!(name in mod)) throw new Error('Missing export ' + name); } })\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22.13"
  }
}
